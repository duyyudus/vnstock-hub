#!/bin/zsh

set -euo pipefail

REGISTRY_REF="${REGISTRY_REF:-host.docker.internal:5001}"
RELAY_PORT="${RELAY_PORT:-5001}"
REMOTE_REGISTRY_HOST="${REMOTE_REGISTRY_HOST:-192.168.100.39}"
REMOTE_REGISTRY_PORT="${REMOTE_REGISTRY_PORT:-5000}"
TARGET_PLATFORM="${TARGET_PLATFORM:-linux/amd64}"
VITE_API_BASE_URL="${VITE_API_BASE_URL:-http://192.168.100.39:8020}"
SOCAT_LOG="${SOCAT_LOG:-/tmp/vnstock-hub-socat.log}"
SOCAT_PID=""

cleanup() {
  if [[ -n "${SOCAT_PID}" ]] && kill -0 "${SOCAT_PID}" >/dev/null 2>&1; then
    echo "Stopping relay on port ${RELAY_PORT}"
    kill "${SOCAT_PID}" >/dev/null 2>&1 || true
    wait "${SOCAT_PID}" 2>/dev/null || true
  fi
}

ensure_relay() {
  local existing_pid existing_cmd expected_target

  expected_target="TCP:${REMOTE_REGISTRY_HOST}:${REMOTE_REGISTRY_PORT}"
  existing_pid="$(lsof -tiTCP:"${RELAY_PORT}" -sTCP:LISTEN 2>/dev/null | head -n 1 || true)"

  if [[ -z "${existing_pid}" ]]; then
    echo "Starting relay on port ${RELAY_PORT} -> ${REMOTE_REGISTRY_HOST}:${REMOTE_REGISTRY_PORT}"
    nohup socat \
      TCP-LISTEN:"${RELAY_PORT}",reuseaddr,fork,bind=0.0.0.0 \
      TCP:"${REMOTE_REGISTRY_HOST}":"${REMOTE_REGISTRY_PORT}" \
      >"${SOCAT_LOG}" 2>&1 &
    SOCAT_PID=$!
    sleep 1
    return
  fi

  existing_cmd="$(ps -p "${existing_pid}" -o command= 2>/dev/null || true)"
  if [[ "${existing_cmd}" == *"socat"* && "${existing_cmd}" == *"${expected_target}"* ]]; then
    echo "Reusing existing relay on port ${RELAY_PORT}"
    return
  fi

  echo "Port ${RELAY_PORT} is already in use by: ${existing_cmd}"
  echo "Refusing to reuse it because it is not the expected relay to ${REMOTE_REGISTRY_HOST}:${REMOTE_REGISTRY_PORT}"
  exit 1
}

trap cleanup EXIT

if [[ "${REGISTRY_REF}" == "host.docker.internal:${RELAY_PORT}" ]]; then
  if ! command -v socat >/dev/null 2>&1; then
    echo "socat is required for Mac relay mode. Install it with: brew install socat"
    exit 1
  fi

  ensure_relay
fi

if ! docker buildx version >/dev/null 2>&1; then
  echo "docker buildx is required for cross-platform Mac builds."
  exit 1
fi

BUILD_NUMBER=$(git rev-list --count HEAD)
BACKEND_LATEST_IMAGE="${REGISTRY_REF}/vnstock-hub-backend:latest"
FRONTEND_LATEST_IMAGE="${REGISTRY_REF}/vnstock-hub-frontend:latest"
BACKEND_BUILD_IMAGE="${REGISTRY_REF}/vnstock-hub-backend:${BUILD_NUMBER}"
FRONTEND_BUILD_IMAGE="${REGISTRY_REF}/vnstock-hub-frontend:${BUILD_NUMBER}"

echo "Using registry ${REGISTRY_REF}, build number: ${BUILD_NUMBER}, target platform: ${TARGET_PLATFORM}"

docker buildx build \
  --platform "${TARGET_PLATFORM}" \
  --build-arg VNSTOCK_API_KEY="${VNSTOCK_API_KEY:-}" \
  --build-arg BUILD_NUMBER="${BUILD_NUMBER}" \
  --tag "${BACKEND_LATEST_IMAGE}" \
  --tag "${BACKEND_BUILD_IMAGE}" \
  --push \
  ./backend

docker buildx build \
  --platform "${TARGET_PLATFORM}" \
  --build-arg VITE_API_BASE_URL="${VITE_API_BASE_URL}" \
  --build-arg VITE_APP_BUILD="${BUILD_NUMBER}" \
  --tag "${FRONTEND_LATEST_IMAGE}" \
  --tag "${FRONTEND_BUILD_IMAGE}" \
  --push \
  ./frontend

echo "Pushed tags:"
echo "  - ${BACKEND_LATEST_IMAGE}"
echo "  - ${BACKEND_BUILD_IMAGE}"
echo "  - ${FRONTEND_LATEST_IMAGE}"
echo "  - ${FRONTEND_BUILD_IMAGE}"
echo "These tags were built for ${TARGET_PLATFORM}."
echo "Registry push updates the registry only."
echo "On the deployment host, pull the new image or run docker compose pull before restarting containers."
echo "The registry host's local 'docker images' list will stay unchanged until that host pulls the new tag."
