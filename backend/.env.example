# Backend Environment Variables

# Database Configuration
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/vnstock_hub

# API Configuration
API_V1_PREFIX=/api/v1

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional: override settings.yaml location
SETTINGS_YAML_PATH=./backend/settings.yaml

# vnstock API
VNSTOCK_API_KEY=
USE_VNSTOCK_ALT=false
USE_VNSTOCK_DATA_ALT=false
SYNC_TARGET_RPM=150
SYNC_MAX_WORKERS=10
SYNC_CHUNK_DAYS=1825
SYNC_RATE_LIMIT_FIXED_WAIT_SECONDS=30
SYNC_RATE_LIMIT_MAX_WAIT_SECONDS=1200

JWT_SECRET_KEY=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Providers (OpenAI-compatible) for portfolio import
LLM_PROVIDERS='[
  {"name":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"YOUR_KEY","model":"gpt-4o-mini"},
  {"name":"openrouter","base_url":"https://openrouter.ai/api/v1","api_key":"YOUR_KEY","model":"openai/gpt-4o-mini"}
]'
LLM_REQUEST_TIMEOUT_SECONDS=30

SYNC_ADMIN_EMAILS='["you@example.com"]'
