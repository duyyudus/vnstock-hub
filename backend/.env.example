# Backend Environment Variables

# Database Configuration
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/vnstock_hub

# API Configuration
API_V1_PREFIX=/api/v1

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional: override settings.yaml location
SETTINGS_YAML_PATH=./settings.yaml
# Optional: override built-in public news source config
NEWS_SOURCES_YAML_PATH=./news_sources.yaml

# vnstock API
VNSTOCK_API_KEY=
USE_VNSTOCK_ALT=true
USE_VNSTOCK_DATA_ALT=true
SYNC_TARGET_RPM=150
SYNC_MAX_WORKERS=10
SYNC_CHUNK_DAYS=1825
SYNC_RATE_LIMIT_FIXED_WAIT_SECONDS=30
SYNC_RATE_LIMIT_MAX_WAIT_SECONDS=1200

JWT_SECRET_KEY=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM providers (OpenAI-compatible) shared across tasks
LLM_PROVIDERS='[
  {"name":"openrouter","base_url":"https://openrouter.ai/api/v1","api_key":"YOUR_KEY","model":"openai/gpt-5.4-nano"},
  {"name":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"YOUR_KEY","model":"gemini-3.1-flash-lite-preview"}
]'
LLM_TASK_CONFIG='{
  "default": [{"provider":"openrouter"}],
  "position_image_extraction": [{"provider":"openrouter","model":"google/gemini-3.1-flash-lite-preview"}],
  "position_table_extraction": [{"provider":"openrouter","model":"google/gemini-3.1-flash-lite-preview"}],
  "news_article_summary": [{"provider":"openrouter","model":"openai/gpt-5.4-nano"}],
  "news_article_classification": [{"provider":"openrouter","model":"openai/gpt-5.4-nano"}],
  "news_article_discussion": [{"provider":"openrouter","model":"openai/gpt-5.4-nano"}],
  "news_article_discussion_decision": [{"provider":"openrouter","model":"openai/gpt-5.4-nano"}],
  "news_article_discussion_query": [{"provider":"openrouter","model":"openai/gpt-5.4-nano"}],
  "news_blocked_label_compilation": [{"provider":"openrouter","model":"openai/gpt-5.4-nano"}]
}'
LLM_REQUEST_TIMEOUT_SECONDS=30

SYNC_ADMIN_EMAILS='["you@example.com"]'

# News ingestion
NEWS_INGESTION_ENABLED=true
NEWS_POLL_INTERVAL_SECONDS=120
# Fallback default for new sources; admin UI can override this in settings.yaml
NEWS_DEFAULT_POLL_INTERVAL_MINUTES=30
NEWS_INGESTION_BATCH_SIZE=5

# News discussion web search
# Leave NEWS_SEARCH_PROVIDER empty to disable explicit web search in article discussion.
# Supported provider values: brave
NEWS_SEARCH_PROVIDER=
NEWS_SEARCH_API_KEY=
NEWS_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
NEWS_SEARCH_TIMEOUT_SECONDS=15
