# Backend Environment Variables
#
# Non-secret backend defaults live in backend/settings.yaml. Use env vars here
# for deployment wiring and secrets, or when you intentionally need to override
# a YAML default.

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vnstock_hub
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
SYNC_ADMIN_EMAILS=["admin@example.com"]

JWT_SECRET_KEY=your_jwt_secret_key_here

# LLM providers (OpenAI-compatible) shared across tasks
LLM_PROVIDERS='[
  {"name":"openrouter","base_url":"https://openrouter.ai/api/v1","api_key":"YOUR_OPENROUTER_API_KEY","model":"openai/gpt-5.4-nano"},
  {"name":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"YOUR_GEMINI_API_KEY","model":"gemini-3.1-flash-lite-preview"}
]'
