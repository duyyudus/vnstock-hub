# Backend Test Environment Variables

# Database Configuration
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/vnstock_hub_test

# API Configuration
API_V1_PREFIX=/api/v1

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional: override settings.yaml location
SETTINGS_YAML_PATH=./settings.yaml

# vnstock API (mock/safe defaults for tests)
VNSTOCK_API_KEY=test-api-key
SYNC_TARGET_RPM=150
SYNC_MAX_WORKERS=10
SYNC_CHUNK_DAYS=1825
SYNC_RATE_LIMIT_FIXED_WAIT_SECONDS=30
SYNC_RATE_LIMIT_MAX_WAIT_SECONDS=1200

JWT_SECRET_KEY=test-jwt-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Providers (OpenAI-compatible) for portfolio import
LLM_PROVIDERS='[{"name":"mock","base_url":"https://example.invalid/v1","api_key":"test-key","model":"mock-model"}]'
LLM_REQUEST_TIMEOUT_SECONDS=30

SYNC_ADMIN_EMAILS='["admin@example.com"]'
