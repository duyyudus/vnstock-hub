# Local Docker build/run defaults.
# Point DATABASE_URL at your existing Postgres.

COMPOSE_PROJECT_NAME=vnstock-hub
BACKEND_PORT=8020
FRONTEND_PORT=3030

BACKEND_IMAGE=vnstock-hub/vnstock-hub-backend
FRONTEND_IMAGE=vnstock-hub/vnstock-hub-frontend
IMAGE_TAG=latest

VITE_API_BASE_URL=http://localhost:8020

DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/vnstock_hub
CORS_ORIGINS=["http://localhost:3030"]
SYNC_ADMIN_EMAILS=[]

# Keep JSON env values on one line so Docker Compose and docker-build parse them consistently.
JWT_SECRET_KEY=change-me-local
LLM_PROVIDERS=[{"name":"openrouter","base_url":"https://openrouter.ai/api/v1","api_key":"YOUR_OPENROUTER_API_KEY","model":"openai/gpt-5.4-nano"},{"name":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"YOUR_GEMINI_API_KEY","model":"gemini-3.1-flash-lite-preview"}]
