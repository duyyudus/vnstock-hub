# Production/remote registry defaults.
# Copy this file to .env.prod and replace every placeholder for your deployment.

COMPOSE_PROJECT_NAME=vnstock-hub
BACKEND_PORT=8020
FRONTEND_PORT=3030

REGISTRY_REF=registry.example.com:5000
BACKEND_IMAGE=registry.example.com:5000/vnstock-hub-backend
FRONTEND_IMAGE=registry.example.com:5000/vnstock-hub-frontend
IMAGE_TAG=latest

VITE_API_BASE_URL=https://vnstock-hub.example.com

DATABASE_URL=postgresql+asyncpg://vnstock_user:replace-me@postgres.example.com:5432/vnstock_hub
CORS_ORIGINS=["https://vnstock-hub.example.com"]
SYNC_ADMIN_EMAILS=["admin@example.com"]

# Keep JSON env values on one line so Docker Compose and docker-build parse them consistently.
JWT_SECRET_KEY=replace-me-with-a-long-random-secret
LLM_PROVIDERS=[{"name":"openrouter","base_url":"https://openrouter.ai/api/v1","api_key":"YOUR_OPENROUTER_API_KEY","model":"openai/gpt-5.4-nano"},{"name":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"YOUR_GEMINI_API_KEY","model":"gemini-3.1-flash-lite-preview"}]
