{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Backend Server",
			"type": "shell",
			"command": "./run-server",
			"problemMatcher": []
		},
		{
			"label": "Run Frontend UI",
			"type": "shell",
			"command": "./run-ui",
			"problemMatcher": []
		},
		{
			"label": "Run Backend MkDocs",
			"type": "shell",
			"command": "uv run mkdocs serve -f mkdocs.yml",
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"problemMatcher": []
		}
	]
}
